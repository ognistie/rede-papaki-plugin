{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/instalar-skill.js"]
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__plugin_rede-papaki_rede-papaki__.*",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/guarda-escrita.js"]
          }
        ]
      }
    ]
  }
}
